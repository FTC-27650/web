---
import Pagination from "../../components/control/Pagination.astro";
import PostPage from "../../components/PostPage.astro";
import { PAGE_SIZE } from "../../constants/constants";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export async function getStaticPaths() {
	const allBlogPosts = await getSortedPosts();
	const pages = Math.ceil(allBlogPosts.length / PAGE_SIZE);

	return Array.from({ length: Math.max(1, pages) }).map((_, i) => ({
		params: { page: String(i + 1) },
		props: {
			page: {
				data: allBlogPosts.slice(i * PAGE_SIZE, (i + 1) * PAGE_SIZE),
				current: i + 1,
				last: Math.max(1, pages),
				url: {
					next: i < pages - 1 ? `/blog/${i + 2}` : undefined,
					prev: i > 0 ? `/blog/${i}` : undefined,
					first: '/blog',
					last: pages > 1 ? `/blog/${pages}` : '/blog',
				},
			},
		},
	}));
}

const { page } = Astro.props;
const len = page.data.length;
---
<MainGridLayout title="Blog">
    <div class="blog-header mb-8">
        <h1 class="text-3xl font-bold mb-2">Team Blog</h1>
        <p class="text-[var(--text-secondary)]">
            Follow our journey through the FTC season with updates, insights, and stories from our team.
        </p>
    </div>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>
